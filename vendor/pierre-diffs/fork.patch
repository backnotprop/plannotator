diff --git a/packages/diffs/src/utils/getCodeColumns.ts b/packages/diffs/src/utils/getCodeColumns.ts
new file mode 100644
index 00000000..4d1723fd
--- /dev/null
+++ b/packages/diffs/src/utils/getCodeColumns.ts
@@ -0,0 +1,30 @@
+/** A code element's gutter and content columns. */
+export interface CodeColumnElements {
+  gutter: HTMLElement;
+  content: HTMLElement;
+}
+
+/**
+ * The gutter and content columns of a code element, found by their attributes
+ * rather than their position, so a node the layout did not draw (one a browser
+ * extension put there, say) does not hide them. Undefined when either is
+ * missing.
+ */
+export function getCodeColumns(
+  code: Element | undefined
+): CodeColumnElements | undefined {
+  if (code == null) {
+    return undefined;
+  }
+  let gutter: HTMLElement | undefined;
+  let content: HTMLElement | undefined;
+  for (const child of code.children) {
+    if (!(child instanceof HTMLElement)) continue;
+    if (gutter == null && child.hasAttribute('data-gutter')) {
+      gutter = child;
+    } else if (content == null && child.hasAttribute('data-content')) {
+      content = child;
+    }
+  }
+  return gutter == null || content == null ? undefined : { gutter, content };
+}
