---
import Base from '../../layouts/Base.astro';
import SignupDialog from '../../components/spaces/SignupDialog.astro';
import SpacesFootStrip from '../../components/spaces/SpacesFootStrip.astro';
import SpacesTopStrip from '../../components/spaces/SpacesTopStrip.astro';
import '../../styles/spaces/page.css';
import '../../styles/spaces/decide.css';
import '../../styles/spaces/signup.css';
import '../../styles/spaces/site.css';
import '../../styles/spaces/header.css';
---
<Base
  title="Plannotator Spaces"
  description="Your team and your agents review every plan, mock-up and decision in one place."
>
  <Fragment slot="head">
    <!-- The users row starts closed and opens on the first scroll (scripts/spaces/page.js). -->
    <script is:inline>document.documentElement.classList.add("pfc");</script>
    <!-- Light or dark before paint. The site's plannotator-theme cookie wins when it says light or dark;
         with no cookie (or "system") this page follows the system setting. Base.astro only ever adds
         .light in the cases this also does. The switch in the top bar is in scripts/spaces/theme-switch.js. -->
    <script is:inline>(function(){var m=document.cookie.match(/(?:^|; )plannotator-theme=([^;]*)/),t=m?decodeURIComponent(m[1]):"";if(t!=="light"&&t!=="dark")t=matchMedia("(prefers-color-scheme: light)").matches?"light":"dark";document.documentElement.classList.toggle("light",t==="light")})();</script>
    <!-- The two handwriting subsets carry the first-screen notes; fetch them with the CSS, not after layout. -->
    <link rel="preload" href="/fonts/spaces-hand/SpacesHandOne.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spaces-hand/SpacesHandTwo.woff2" as="font" type="font/woff2" crossorigin />
  </Fragment>

<SpacesTopStrip />
<main>
<div class="frame">
  
  <svg class="stars" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g class="dk"><circle cx="212" cy="148" r="1.1" opacity="0.6"/><circle cx="648" cy="112" r="1.3" opacity="1"/><circle cx="884" cy="64" r="1.1" opacity="0.7"/><circle cx="1392" cy="236" r="1.3" opacity="0.8"/><circle cx="792" cy="782" r="1.2" opacity="0.8"/><circle cx="1268" cy="852" r="1" opacity="0.6"/><circle cx="518" cy="806" r="1.1" opacity="0.6"/><circle cx="132" cy="742" r="1" opacity="0.5"/><circle cx="60" cy="430" r="1" opacity="0.5"/><circle cx="338" cy="96" r="0.9" opacity="0.5"/><circle cx="470" cy="168" r="1.3" opacity="0.95"/><circle cx="352" cy="760" r="1.3" opacity="0.8"/><circle cx="700" cy="860" r="0.9" opacity="0.5"/><circle cx="1414" cy="96" r="0.9" opacity="0.5"/><circle cx="900" cy="790" r="1.3" opacity="0.95"/><circle cx="30" cy="120" r="1.2" opacity="0.6"/><circle cx="984" cy="96" r="0.9" opacity="0.5"/><circle cx="590" cy="690" r="0.8" opacity="0.45"/><circle cx="1150" cy="96" r="1.3" opacity="0.85"/><circle cx="250" cy="850" r="0.9" opacity="0.5"/><circle cx="820" cy="140" r="0.8" opacity="0.5"/><circle cx="1400" cy="470" r="1.3" opacity="0.8"/><circle cx="1330" cy="760" r="0.8" opacity="0.5"/><circle cx="880" cy="430" r="0.7" opacity="0.45"/><circle cx="1180" cy="800" r="1" opacity="0.6"/><circle cx="1100" cy="480" r="0.7" opacity="0.4"/><circle cx="1392" cy="640" r="1" opacity="0.5"/></g></svg>

  

