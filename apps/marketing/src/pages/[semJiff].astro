---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GitHubStars from '../components/landing/GitHubStars';
import { SEM_JIFF_NAME, SEM_JIFF_PACKAGE, SEM_JIFF_REPO } from '../lib/sem-jiff';

export function getStaticPaths() {
  return [{ params: { semJiff: SEM_JIFF_NAME } }];
}

const installCmd = `npm install ${SEM_JIFF_PACKAGE}`;

const languages = ['TypeScript', 'TSX', 'JavaScript', 'Python', 'Go', 'Rust', 'Java', 'C#', 'PHP', 'Ruby', 'Kotlin', 'Swift'];

const labels = [
  { key: 'hero', name: 'All in one file', alt: 'One TypeScript file in split view: roundCents moved, sumItems extracted, auditSubtotal inlined, amt renamed to lineTotal, with bands joining each block to its new place and two real edits left plain' },
  { key: 'extracted', name: 'Extracted function', alt: 'Kotlin: two lines pulled out of the receipt printer into appendTotal, which the original now calls' },
  { key: 'inlined', name: 'Inlined function', alt: 'TypeScript: the helper auditSubtotal removed and its body placed at the call site' },
  { key: 'moved', name: 'Moved', alt: 'Python: format_amount moved to the end of the file, folded on the old side, next to one real edit' },
  { key: 'renamed', name: 'Renamed', alt: 'PHP: $amt renamed to $requested in all five places, each marked renamed' },
  { key: 'reformatted', name: 'Reformatted', alt: 'TypeScript: quoteShipping re-wrapped from two lines to eight, marked reformatted' },
];

const finalSet = {
  total: 193,
  rows: [
    { key: 'engine', name: 'Engine alone', found: 127, pct: 66, wrong: 1, claims: 133 },
    { key: 'jev', name: '+ Jev', found: 168, pct: 87, wrong: 5, claims: 181 },
    { key: 'clef', name: '+ Jev, Clef as tie-breaker', found: 171, pct: 89, wrong: 5, claims: 186 },
  ],
};

const heldOut = {
  total: 454,
  rows: [
    { key: 'n1', name: 'Engine alone', found: 263, wrong: 8 },
    { key: 'n2', name: '+ Jev', found: 371, wrong: 12 },
    { key: 'lead', name: '+ Jev, Clef as tie-breaker', found: 388, wrong: 13 },
  ],
};

const compare = [
  {
    name: 'TypeScript',
    total: 187,
    rows: [
      { key: 'n1', name: 'RefactoringMiner', found: 73, wrong: 14 },
      { key: 'n2', name: SEM_JIFF_NAME, found: 105, wrong: 1 },
      { key: 'lead', name: `${SEM_JIFF_NAME} + Jev`, found: 148, wrong: 1 },
    ],
  },
  {
    name: 'Java',
    total: 91,
    rows: [
      { key: 'n1', name: 'RefactoringMiner', found: 70, wrong: 16 },
      { key: 'n2', name: SEM_JIFF_NAME, found: 52, wrong: 1 },
      { key: 'lead', name: `${SEM_JIFF_NAME} + Jev`, found: 62, wrong: 1 },
    ],
  },
];

type LinesLeftRow = { key: 'engine' | 'other'; tool: string; linesLeft: number };

const linesLeftToReview: { subtitle: string; rows: LinesLeftRow[] } = { subtitle: '', rows: [] };

const hasLinesLeft = linesLeftToReview.rows.length > 0;
const linesLeftMax = Math.max(1, ...linesLeftToReview.rows.map((r) => r.linesLeft));

const wrongClaims = [
  {
    name: 'Kotlin',
    projects: 'ktor, Exposed',
    rows: [
      { key: 'engine', name: SEM_JIFF_NAME, wrong: 0, of: 46, unit: 'claims' },
      { key: 'other', name: 'difftastic', wrong: 51, of: 70, unit: 'claims' },
      { key: 'other', name: 'sem 0.8.0', wrong: 40, of: 164, unit: 'audited' },
    ],
  },
  {
    name: 'Swift',
    projects: 'swift-nio, TCA',
    rows: [
      { key: 'engine', name: SEM_JIFF_NAME, wrong: 0, of: 158, unit: 'claims' },
      { key: 'other', name: 'difftastic', wrong: 13, of: 88, unit: 'audited' },
      { key: 'other', name: 'sem 0.8.0', wrong: 4, of: 95, unit: 'audited' },
    ],
  },
];

const torrentWords = ['MOVED', 'RENAMED', 'REFORMATTED', 'EXTRACTED', 'INLINED', 'EDITED'];
const tileTones = ['t0', 't1', 't2', 't3', 't4'];

const makeTorrent = (rows: number, seed: number, minTiles: number, growth: number) => {
  let a = seed;
  const rand = () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
  return Array.from({ length: rows }, (_, r) => {
    const count = minTiles + Math.floor(r * growth);
    return Array.from({ length: count }, () => {
      const roll = rand();
      if (roll < 0.1) return { kind: 'plus', text: '+' };
      if (roll < 0.13) return { kind: 'minus', text: '−' };
      if (roll < 0.17) return { kind: 'led', text: '+' };
      if (roll < 0.195) return { kind: 'ask', text: '?' };
      if (roll < 0.215) return { kind: 'ok', text: '✓' };
      return { kind: tileTones[Math.floor(rand() * tileTones.length)], text: torrentWords[Math.floor(rand() * torrentWords.length)] };
    });
  });
};

const heroTorrent = makeTorrent(15, 1123, 1, 0.75);
const dividerTorrent = makeTorrent(2, 4419, 26, 0);

const pctOf = (n: number, total: number) => `${((n / total) * 100).toFixed(2)}%`;

const title = `${SEM_JIFF_NAME}: semantic and structural diffs · Plannotator`;
const description =
  'Semantic and structural diffs. A tree-sitter engine that reads a code diff and labels what really happened: moved, renamed, reformatted, extracted and inlined functions. Power Up with Jev and Clef to find more. Powers the Sem tab in Plannotator code review.';
---

<Base title={title} description={description}>
  <link slot="head" rel="preload" href="/fonts/paper-mono/PaperMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
  <link slot="head" rel="preload" href="/fonts/geist/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
  <div class="sd-static min-h-screen bg-background text-foreground">
    <Nav />

    <main class="max-w-6xl mx-auto px-6 md:px-8">
      <div class="sd-hero-wrap">
      <header class="sd-hero">
        <div class="sd-cmd-row">
          <div class="sd-cmd">
            <span class="sd-cmd-prompt" aria-hidden="true">$</span>
            <code class="sd-cmd-text">{installCmd}</code>
            <button type="button" class="sd-copy" data-copy={installCmd} aria-label="Copy the install command">
              <svg class="sd-copy-icon" data-copy-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" /></svg>
              <svg class="sd-copy-icon" data-copied-icon hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
            </button>
            <span class="sd-copy-status" data-copy-status role="status" aria-live="polite"></span>
          </div>
          <a
            href="https://github.com/backnotprop/plannotator"
            target="_blank"
            rel="noopener noreferrer"
            class="sd-gh"
            aria-label="Plannotator on GitHub"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z"/></svg>
            <GitHubStars client:load />
          </a>
        </div>

        <h1 class="sd-heading">semantic and<br />structural diffs</h1>
        <p class="sd-line">
          <span class="sd-line-engine">label structural noise.</span>
          <span class="sd-line-you">understand real changes.</span>
        </p>
        <p class="sd-overview">
          {SEM_JIFF_NAME} reads both sides of a code diff with tree-sitter and labels what actually
          happened, so reviewers skip the noise and read the real edits. It powers the Sem
          tab in Plannotator's code review.
          <a href="#power-up" class="sd-powered">Powered up by decision models, <span class="sd-rainbow">like Jev by Typesafe</span>, for deeper structural diff understanding.</a>
        </p>


        <ul class="sd-langs" aria-label="Languages">
          {languages.map((l) => (
            <li>{l}</li>
          ))}
        </ul>
      </header>
      <div class="sd-torrent" aria-hidden="true">
        {heroTorrent.map((row) => (
          <div class="sd-torrent-row">
            {row.map((t) => <span class={`sd-tile sd-tile-${t.kind}`}>{t.text}</span>)}
          </div>
        ))}
      </div>
      </div>

      <section class="sd-gallery" aria-label="What it labels">
        <div class="sd-labels" role="tablist" aria-label="Change types">
          {labels.map((l, i) => (
            <button
              type="button"
              role="tab"
              class="sd-label"
              id={`sd-tab-${l.key}`}
              aria-controls={`sd-shot-${l.key}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-shot-tab={l.key}
            >{l.name}</button>
          ))}
        </div>
        <figure class="sd-shot">
          {labels.map((l, i) => (
            <div
              class="sd-shot-pane"
              role="tabpanel"
              id={`sd-shot-${l.key}`}
              aria-labelledby={`sd-tab-${l.key}`}
              data-shot-pane={l.key}
              hidden={i !== 0}
            >
              <picture>
                <source media="(max-width: 640px)" srcset={`/assets/semantic-labels/diff-${l.key}-dark-phone.webp`} />
                <img src={`/assets/semantic-labels/diff-${l.key}-dark.webp`} alt={l.alt} width="2400" loading={i === 0 ? 'eager' : 'lazy'} />
              </picture>
            </div>
          ))}
        </figure>
        <div class="sd-torrent sd-torrent-divider" aria-hidden="true">
          {dividerTorrent.map((row) => (
            <div class="sd-torrent-row">
              {row.map((t) => <span class={`sd-tile sd-tile-${t.kind}`}>{t.text}</span>)}
            </div>
          ))}
        </div>
      </section>

      <section id="power-up" class="sd-section">
        <h2 class="sd-title">power up with Jev and Clef</h2>
        <p class="sd-body">
          Add your own Jev key and the engine asks a model about the candidates its strict rules
          aren't sure of. Add Clef and it breaks the ties.
        </p>

        <div class="sd-card sd-viz" data-viz>
          <div class="sd-card-head">
            <h3 class="sd-card-title">Extracted and inlined functions found</h3>
            <p class="sd-card-sub">{finalSet.total} real cases across TypeScript, Go, Rust, Python, Java and C#</p>
          </div>

          <div class="sd-bars sd-bars-hero" role="list">
            <div class="sd-bars-colhead" aria-hidden="true">
              <span></span><span></span><span class="sd-colhead-wrong">Wrong claims</span>
            </div>
            {finalSet.rows.map((r) => (
              <div
                class="sd-row"
                role="listitem"
                tabindex="0"
                data-tip={`${r.name}: ${r.found} of ${finalSet.total} found (${r.pct}%), ${r.wrong} wrong of ${r.claims} claims`}
                aria-label={`${r.name}: ${r.found} of ${finalSet.total} found, ${r.pct} percent. ${r.wrong} wrong of ${r.claims} claims.`}
              >
                <span class="sd-row-name">{r.name}</span>
                <span class="sd-track">
                  <span class:list={['sd-bar', `sd-c-${r.key}`]} style={`--p: ${pctOf(r.found, finalSet.total)}`}></span>
                  <span class="sd-bar-val"><strong>{r.pct}%</strong><span class="sd-bar-count">{r.found}</span></span>
                </span>
                <span class="sd-row-wrong"><strong>{r.wrong}</strong> of {r.claims}</span>
              </div>
            ))}
          </div>

          <details class="sd-table">
            <summary>View as table</summary>
            <table>
              <thead><tr><th scope="col"></th><th scope="col">Found</th><th scope="col">Wrong claims</th></tr></thead>
              <tbody>
                {finalSet.rows.map((r) => (
                  <tr><th scope="row">{r.name}</th><td>{r.found} ({r.pct}%)</td><td>{r.wrong} of {r.claims}</td></tr>
                ))}
              </tbody>
            </table>
          </details>
        </div>

        <div class="sd-grid-2">
          <div class="sd-card sd-viz" data-viz>
            <div class="sd-card-head">
              <h3 class="sd-card-title">Held-out sets</h3>
              <p class="sd-card-sub">{heldOut.total} more real cases, found and wrong claims</p>
            </div>
            <div class="sd-bars sd-bars-compact" role="list">
              {heldOut.rows.map((r) => (
                <div
                  class="sd-row"
                  role="listitem"
                  tabindex="0"
                  data-tip={`${r.name}: ${r.found} of ${heldOut.total} found, ${r.wrong} wrong`}
                  aria-label={`${r.name}: ${r.found} of ${heldOut.total} found, ${r.wrong} wrong claims.`}
                >
                  <span class="sd-row-name">{r.name}</span>
                  <span class="sd-track">
                    <span class:list={['sd-bar', `sd-c-${r.key}`]} style={`--p: ${pctOf(r.found, heldOut.total)}`}></span>
                    <span class="sd-bar-val"><strong>{r.found}</strong></span>
                  </span>
                  <span class="sd-row-wrong"><strong>{r.wrong}</strong> wrong</span>
                </div>
              ))}
            </div>
          </div>

          <dl class="sd-stats">
            <div class="sd-stat">
              <dt>per 500-line change with Jev</dt>
              <dd class="sd-stat-val">$0.0004</dd>
            </div>
            <div class="sd-stat">
              <dt>to reopen a diff</dt>
              <dd class="sd-stat-val">$0</dd>
              <dd class="sd-stat-note">Answers are remembered.</dd>
            </div>
          </dl>
        </div>
      </section>

      <section id="compare" class="sd-section">
        <h2 class="sd-title">more found, far fewer wrong</h2>
        <p class="sd-body">
          Extracted and inlined functions on the same commits, next to RefactoringMiner.
        </p>

        <div class="sd-card sd-viz" data-viz>
          <div class="sd-legend" aria-hidden="true">
            {compare[0].rows.map((r) => (
              <span class="sd-legend-item"><span class:list={['sd-swatch', `sd-c-${r.key}`]}></span>{r.name}</span>
            ))}
          </div>

          <div class="sd-compare">
            {compare.map((g) => (
              <div class="sd-group">
                <p class="sd-group-name">{g.name} <span>{g.total} real cases</span></p>
                <div class="sd-bars sd-bars-compact" role="list">
                  {g.rows.map((r) => (
                    <div
                      class="sd-row"
                      role="listitem"
                      tabindex="0"
                      data-tip={`${g.name}, ${r.name}: ${r.found} of ${g.total} found, ${r.wrong} wrong`}
                      aria-label={`${g.name}, ${r.name}: ${r.found} of ${g.total} found, ${r.wrong} wrong claims.`}
                    >
                      <span class="sd-row-name">{r.name}</span>
                      <span class="sd-track">
                        <span class:list={['sd-bar', `sd-c-${r.key}`]} style={`--p: ${pctOf(r.found, g.total)}`}></span>
                        <span class="sd-bar-val"><strong>{r.found}</strong></span>
                      </span>
                      <span class:list={['sd-row-wrong', r.wrong > 5 && 'sd-row-wrong-hi']}><strong>{r.wrong}</strong> wrong</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <details class="sd-table">
            <summary>View as table</summary>
            <table>
              <thead><tr><th scope="col"></th><th scope="col">Found</th><th scope="col">Wrong claims</th></tr></thead>
              <tbody>
                {compare.flatMap((g) =>
                  g.rows.map((r) => (
                    <tr><th scope="row">{g.name} ({g.total}), {r.name}</th><td>{r.found}</td><td>{r.wrong}</td></tr>
                  )),
                )}
              </tbody>
            </table>
          </details>
        </div>
      </section>

      <section id="tools" class="sd-section">
        <h2 class="sd-title">{hasLinesLeft ? 'less to read, fewer wrong claims' : 'fewer wrong claims'}</h2>
        <p class="sd-body">{hasLinesLeft ? 'Next to plain git, git --color-moved, difftastic, GumTree and sem.' : 'Next to difftastic and sem, on projects it was never tuned on.'}</p>

        {hasLinesLeft && (
          <div class="sd-card sd-viz" id="lines-left">
            <div class="sd-card-head">
              <h3 class="sd-card-title">Lines left to review</h3>
              <p class="sd-card-sub">{linesLeftToReview.subtitle}</p>
            </div>
            <div class="sd-bars sd-bars-compact sd-bars-lines" role="list">
              {linesLeftToReview.rows.map((r) => (
                <div
                  class="sd-row"
                  role="listitem"
                  tabindex="0"
                  data-tip={`${r.tool}: ${r.linesLeft.toLocaleString('en-US')} lines left to review`}
                  aria-label={`${r.tool}: ${r.linesLeft} lines left to review.`}
                >
                  <span class="sd-row-name">{r.tool}</span>
                  <span class="sd-track">
                    <span class:list={['sd-bar', r.key === 'engine' ? 'sd-c-lead' : 'sd-c-n1']} style={`--p: ${pctOf(r.linesLeft, linesLeftMax)}`}></span>
                    <span class="sd-bar-val"><strong>{r.linesLeft.toLocaleString('en-US')}</strong></span>
                  </span>
                  <span class="sd-row-wrong"></span>
                </div>
              ))}
            </div>
          </div>
        )}

        <div class="sd-card sd-viz">
          <div class="sd-card-head">
            <h3 class="sd-card-title">Wrong claims on real commits</h3>
            <p class="sd-card-sub">Held-out projects, blind audit: ktor and Exposed (Kotlin), swift-nio and TCA (Swift)</p>
          </div>
          <div class="sd-compare">
            {wrongClaims.map((g) => (
              <div class="sd-group">
                <p class="sd-group-name">{g.name} <span>{g.projects}</span></p>
                <div class="sd-bars sd-bars-compact sd-bars-wrong" role="list">
                  {g.rows.map((r) => (
                    <div
                      class="sd-row"
                      role="listitem"
                      tabindex="0"
                      data-tip={`${g.name}, ${r.name}: ${r.wrong} wrong of ${r.of} ${r.unit}`}
                      aria-label={`${g.name}, ${r.name}: ${r.wrong} wrong of ${r.of} ${r.unit}.`}
                    >
                      <span class="sd-row-name">{r.name}</span>
                      <span class="sd-track">
                        {r.wrong > 0 && <span class:list={['sd-bar', r.key === 'engine' ? 'sd-c-lead' : 'sd-c-n1']} style={`--p: ${pctOf(r.wrong, r.of)}`}></span>}
                        <span class="sd-bar-val"><strong>{r.wrong}</strong> wrong</span>
                      </span>
                      <span class="sd-row-wrong">of {r.of} {r.unit}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="sd-cta">
        <h2 class="sd-title">try it in your next review</h2>
        <p class="sd-body">
          It's already in <a href="/code-review/">Plannotator code review</a>. Or use the engine on its own:
        </p>
        <div class="sd-cmd sd-cmd-block">
          <span class="sd-cmd-prompt" aria-hidden="true">$</span>
          <code class="sd-cmd-text">{installCmd}</code>
          <button type="button" class="sd-copy" data-copy={installCmd} aria-label="Copy the install command">
            <svg class="sd-copy-icon" data-copy-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" /></svg>
            <svg class="sd-copy-icon" data-copied-icon hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
          </button>
          <span class="sd-copy-status" data-copy-status role="status" aria-live="polite"></span>
        </div>
        <div class="sd-cta-actions">
          <a href="/code-review/" class="sd-btn">
            Plannotator code review
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a href={SEM_JIFF_REPO} target="_blank" rel="noopener noreferrer" class="sd-btn sd-btn-outline">GitHub</a>
        </div>
      </section>
    </main>

    <div class="sd-tip" data-tip-el role="tooltip" hidden></div>

    <script is:inline>
      (() => {
        document.querySelectorAll('[data-copy]').forEach((btn) => {
          const wrap = btn.closest('.sd-cmd');
          const status = wrap?.querySelector('[data-copy-status]');
          const icon = btn.querySelector('[data-copy-icon]');
          const done = btn.querySelector('[data-copied-icon]');
          let timer;
          btn.addEventListener('click', () => {
            const text = btn.getAttribute('data-copy') || '';
            navigator.clipboard?.writeText(text).then(() => {
              if (icon) icon.hidden = true;
              if (done) done.hidden = false;
              if (status) status.textContent = 'copied';
              clearTimeout(timer);
              timer = setTimeout(() => {
                if (icon) icon.hidden = false;
                if (done) done.hidden = true;
                if (status) status.textContent = '';
              }, 1500);
            }).catch(() => {});
          });
        });

        const tip = document.querySelector('[data-tip-el]');
        const showTip = (el) => {
          if (!tip) return;
          tip.textContent = el.getAttribute('data-tip') || '';
          tip.hidden = false;
          const r = el.querySelector('.sd-bar')?.getBoundingClientRect() || el.getBoundingClientRect();
          const t = tip.getBoundingClientRect();
          const left = Math.min(Math.max(8, r.right - t.width / 2), window.innerWidth - t.width - 8);
          tip.style.left = `${left}px`;
          tip.style.top = `${r.top - t.height - 8}px`;
        };
        const hideTip = () => { if (tip) tip.hidden = true; };
        document.querySelectorAll('[data-tip]').forEach((el) => {
          el.addEventListener('pointerenter', () => showTip(el));
          el.addEventListener('pointerleave', hideTip);
          el.addEventListener('focus', () => showTip(el));
          el.addEventListener('blur', hideTip);
        });
        window.addEventListener('scroll', hideTip, { passive: true });

        const tabs = [...document.querySelectorAll('[data-shot-tab]')];
        const select = (key) => {
          tabs.forEach((t) => t.setAttribute('aria-selected', t.getAttribute('data-shot-tab') === key ? 'true' : 'false'));
          document.querySelectorAll('[data-shot-pane]').forEach((p) => { p.hidden = p.getAttribute('data-shot-pane') !== key; });
        };
        tabs.forEach((t, i) => {
          t.addEventListener('click', () => select(t.getAttribute('data-shot-tab')));
          t.addEventListener('keydown', (e) => {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
            const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
            next.focus();
            select(next.getAttribute('data-shot-tab'));
          });
        });
      })();
    </script>

