---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import AgentLevel from '../../../components/inbox/AgentLevel.astro';
import AgentsPageScript from '../../../components/inbox/AgentsPageScript.astro';
import '../../../components/inbox/agents.css';
import { INBOX_LAUNCHED } from '../../../lib/inbox-launch';
import { AGENTS, COLUMNS, TIERS, agentHref, agentsOfTier } from '../../../lib/inbox-agents';

// /inbox/agents/: which agents get the most out of the Inbox, and what works
// with each one. Generated with /inbox/, behind the same launch switch. Every
// word about an agent comes from src/lib/inbox-agents.ts.
export function getStaticPaths() {
  return INBOX_LAUNCHED ? [{ params: { inbox: 'inbox' } }] : [];
}

const title = 'Agents and the Plannotator Inbox';
const description =
  'What works with each coding agent in the Plannotator Inbox: which ones get your reply on their own and which ones read it when they next check.';
const inboxCols = COLUMNS.inbox;
const plannotatorCols = COLUMNS.plannotator;
const cols = [...inboxCols, ...plannotatorCols];
---

<Base title={title} description={description} ogImage="https://plannotator.ai/assets/inbox/inbox-og.jpg">
  <div class="min-h-screen bg-background text-foreground">
    <Nav />

    <main class="ag-main max-w-6xl mx-auto px-6 md:px-8">
      <header class="ag-hero">
        <p class="ag-kicker"><a href="/inbox/">Plannotator Inbox</a></p>
        <h1 class="font-display ag-heading">Your agent and the Inbox <em>what works and what doesn't yet</em></h1>
        <p class="ag-lede">
          How an agent connects to Plannotator decides how much of the Inbox it gets. With Plannotator's own plug-in
          your reply arrives in the session by itself. Through a shim or MCP alone the agent sees your reply when it
          next checks the Inbox, except on Codex and Qwen Code. Every connected agent can send you questions with
          choices and files to annotate and guided reviews.
        </p>
      </header>

      <!-- ── The three tiers ── -->
      <section class="ag-arc" aria-labelledby="ag-tiers">
        <h2 class="font-display ag-arc-title" id="ag-tiers">Three ways an agent connects</h2>
      </section>
      <div class="ag-tiers">
        {TIERS.map((tier) => (
          <section class="ag-tier" aria-labelledby={`ag-tier-${tier.id}`}>
            <h3 class="ag-title" id={`ag-tier-${tier.id}`}>{tier.name}</h3>
            <p class="ag-tier-get">{tier.get}</p>
            <p class="ag-tier-miss">{tier.miss}</p>
            <ul class="ag-tier-agents" aria-label={`${tier.name} agents`}>
              {agentsOfTier(tier.id).map((a) => (
                <li><a href={agentHref(a.slug)}>{a.name}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <!-- ── The table ── -->
      <section class="ag-arc" aria-labelledby="ag-table-h">
        <h2 class="font-display ag-arc-title" id="ag-table-h">What works with each agent</h2>
        <p class="ag-body">
          The Inbox first, then the rest of Plannotator. Pick an agent for how to install it and what doesn't work yet.
        </p>
      </section>

      <div class="ag-table-wrap">
        <table class="ag-table" role="table" aria-labelledby="ag-table-h">
          <thead role="rowgroup">
            <tr role="row" class="ag-groups">
              <td role="cell"></td>
              <th role="columnheader" scope="colgroup" colspan={inboxCols.length}>With the Inbox</th>
              <th role="columnheader" scope="colgroup" colspan={plannotatorCols.length} class="ag-group-start">In Plannotator</th>
            </tr>
            <tr role="row">
              <th role="columnheader" scope="col">Agent</th>
              {cols.map((c, i) => (
                <th role="columnheader" scope="col" class:list={[i === inboxCols.length && 'ag-group-start']}>{c.name}</th>
              ))}
            </tr>
          </thead>
          {TIERS.map((tier) => (
            <tbody role="rowgroup">
              <tr role="row" class="ag-tier-row">
                <th role="rowheader" scope="rowgroup" colspan={cols.length + 1}>{tier.name}</th>
              </tr>
              {agentsOfTier(tier.id).map((a) => (
                <tr role="row" class="ag-row">
                  <th role="rowheader" scope="row"><a href={agentHref(a.slug)}>{a.name}</a></th>
                  {inboxCols.map((c) => (
                    <td role="cell" data-label={c.name}><AgentLevel {...a.inbox[c.key]} /></td>
                  ))}
                  {plannotatorCols.map((c, i) => (
                    <td role="cell" data-label={c.name} class:list={[i === 0 && 'ag-group-start']}><AgentLevel {...a.plannotator[c.key]} /></td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>

      <div class="ag-legend">
        <p class="ag-legend-marks">
          <AgentLevel level="yes" label="Works" />
          <AgentLevel level="part" label="Works with a condition the cell names" />
          <AgentLevel level="no" label="Not yet" />
        </p>
        <dl class="ag-legend-cols">
          {cols.map((c) => (
            <div>
              <dt>{c.name}</dt>
              <dd>{c.means}</dd>
            </div>
          ))}
        </dl>
      </div>

      <section class="ag-end" aria-labelledby="ag-end-h">
        <h2 class="font-display ag-title" id="ag-end-h">New to the Inbox</h2>
        <p class="ag-body">
          Install Plannotator and run <code>plannotator inbox</code>. It connects the agents it finds on this computer.
          The <a class="ag-link" href="/inbox/#install">Inbox page</a> has the steps.
        </p>
        <p class="ag-others" aria-label="Every agent">
          {AGENTS.map((a) => <a class="ag-link" href={agentHref(a.slug)}>{a.name}</a>)}
        </p>
      </section>
    </main>

    <AgentsPageScript />
    <Footer />
  </div>
</Base>

<style>
  /* ── Tiers (the /inbox/ page's ib-loop-node cards, without the arrows) ── */
  .ag-tiers {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 860px) {
    .ag-tiers { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .ag-tier {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 1.5rem 1.625rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--card);
  }

  .ag-tier-get {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: color-mix(in oklab, var(--foreground) 80%, transparent);
  }

  .ag-tier-miss {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ag-subtle);
  }

  .ag-tier-agents {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .ag-tier-agents a {
    display: inline-flex;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--foreground);
    transition: background-color 150ms ease-out;
  }

  .ag-tier-agents a:hover { background: color-mix(in oklab, var(--foreground) 6%, transparent); }

  /* ── The table ── */
  .ag-table-wrap {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--card);
    overflow: hidden;
  }

  .ag-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }

  .ag-table th,
  .ag-table td {
    padding: 0.7rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .ag-table thead th {
    font-weight: 600;
    color: var(--foreground);
    line-height: 1.3;
  }

  .ag-groups th {
    padding-bottom: 0;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .ag-table thead tr:last-child th {
    border-bottom: 1px solid var(--border);
  }

  .ag-table .ag-group-start {
    border-left: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
  }

  .ag-tier-row th {
    padding-top: 1.1rem;
    padding-bottom: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--primary);
  }

  .ag-row th {
    font-weight: 600;
    white-space: nowrap;
  }

  .ag-row th a {
    color: var(--foreground);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--foreground) 25%, transparent);
    text-underline-offset: 3px;
  }

  .ag-row th a:hover { text-decoration-color: var(--primary); }

  .ag-row + .ag-row th,
  .ag-row + .ag-row td {
    border-top: 1px solid color-mix(in oklab, var(--border) 55%, transparent);
  }

  .ag-row:hover { background: color-mix(in oklab, var(--foreground) 3%, transparent); }

  /* Phones and narrow windows: one block per agent, each answer under the
     column's name. The roles above keep it a table for screen readers. */
  @media (max-width: 899px) {
    .ag-table-wrap { border: 0; background: none; border-radius: 0; overflow: visible; }
    .ag-table,
    .ag-table tbody,
    .ag-table tr,
    .ag-table th,
    .ag-table td { display: block; }
    .ag-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .ag-table tbody + tbody { margin-top: 1.5rem; }
    .ag-tier-row th { padding: 0 0 0.5rem; font-size: 0.8125rem; }
    .ag-row {
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--card);
      padding: 0.25rem 1rem 0.75rem;
    }
    .ag-row + .ag-row { margin-top: 0.625rem; }
    .ag-row:hover { background: var(--card); }
    .ag-row th { padding: 0.75rem 0 0.5rem; font-size: 0.9375rem; white-space: normal; }
    .ag-row td {
      display: grid;
      grid-template-columns: minmax(7.5rem, 40%) minmax(0, 1fr);
      gap: 0.75rem;
      padding: 0.45rem 0;
    }
    .ag-row td::before {
      content: attr(data-label);
      color: var(--muted-foreground);
    }
    .ag-row + .ag-row th,
    .ag-row + .ag-row td { border-top: 0; }
    .ag-table .ag-group-start { border-left: 0; }
    /* The Plannotator group starts after a line. */
    .ag-row td.ag-group-start {
      margin-top: 0.4rem;
      padding-top: 0.85rem;
      border-top: 1px solid color-mix(in oklab, var(--border) 55%, transparent);
    }
  }

  /* ── Legend ── */
  .ag-legend {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .ag-legend-marks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.8125rem;
  }

  .ag-legend-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.625rem 2rem;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  @media (min-width: 720px) {
    .ag-legend-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .ag-legend-cols dt {
    display: inline;
    font-weight: 600;
    color: var(--foreground);
  }

  .ag-legend-cols dt::after { content: ' '; }

  .ag-legend-cols dd {
    display: inline;
    color: var(--ag-dim);
  }
</style>
