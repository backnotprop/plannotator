    <p class="sr-only" aria-live="polite" data-copy-live></p>
    <script is:inline type="application/json" id="ib-install-prompt" set:html={promptJson} />

    <script is:inline>
      (() => {
        const live = document.querySelector('[data-copy-live]');
        const announce = (message) => {
          if (!live) return;
          live.textContent = '';
          setTimeout(() => { live.textContent = message; }, 50);
        };

        // The clipboard API, else a selected off-screen textarea (plain http,
        // older browsers, a denied permission).
        const copyText = (text) => {
          const fallback = () =>
            new Promise((resolve, reject) => {
              const ta = document.createElement('textarea');
              ta.value = text;
              ta.setAttribute('readonly', '');
              ta.setAttribute('aria-hidden', 'true');
              ta.style.position = 'fixed';
              ta.style.top = '0';
              ta.style.left = '0';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              const focused = document.activeElement;
              ta.select();
              try {
                document.execCommand('copy') ? resolve() : reject(new Error('copy failed'));
              } catch (e) {
                reject(e);
              } finally {
                ta.remove();
                if (focused && focused.focus) focused.focus();
              }
            });
          if (navigator.clipboard && window.isSecureContext) {
            return navigator.clipboard.writeText(text).catch(fallback);
          }
          return fallback();
        };

        // Copy buttons in the command blocks.
        const check =
          '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>';
        document.querySelectorAll('[data-copy]').forEach((b) => {
          const icon = b.innerHTML;
          b.addEventListener('click', () => {
            copyText(b.getAttribute('data-copy') || '').then(() => {
              b.innerHTML = check;
              announce('Copied.');
              setTimeout(() => { b.innerHTML = icon; }, 1500);
            }, () => announce('Copy failed. Select the command and copy it by hand.'));
          });
        });

        // "Copy install prompt": the text /inbox/prompt.md serves, inlined.
        const promptNode = document.getElementById('ib-install-prompt');
        const prompt = promptNode ? JSON.parse(promptNode.textContent || '""') : '';
        document.querySelectorAll('[data-copy-prompt]').forEach((b) => {
          const label = b.querySelector('[data-label]');
          let timer;
          const reset = () => {
            b.removeAttribute('data-copied');
            if (label) label.textContent = 'Copy install prompt';
          };
          b.addEventListener('click', () => {
            clearTimeout(timer);
            copyText(prompt).then(
              () => {
                b.setAttribute('data-copied', '');
                if (label) label.textContent = 'Copied. Paste it into your agent';
                announce('Install prompt copied. Paste it into your agent.');
                timer = setTimeout(reset, 3500);
              },
              () => {
                announce('Copy failed. The prompt is at plannotator.ai/inbox/prompt.md.');
              },
            );
          });
        });

        // "Prefer to do it yourself?": the four manual steps.
        const manual = document.getElementById('ib-manual');
        document.querySelectorAll('[data-manual-toggle]').forEach((t) =>
          t.addEventListener('click', () => {
            if (!manual) return;
            const open = manual.hidden;
            manual.hidden = !open;
            t.setAttribute('aria-expanded', String(open));
          }),
        );

        // Tabs: click, or arrow keys / Home / End within a tablist.
        document.querySelectorAll('.ib-setup [role="tablist"]').forEach((list) => {
          const tabs = Array.from(list.querySelectorAll('[role="tab"]'));
          const select = (tab, focus) => {
            tabs.forEach((t) => {
              const on = t === tab;
              t.setAttribute('aria-selected', String(on));
              t.tabIndex = on ? 0 : -1;
              const panel = document.getElementById(t.getAttribute('aria-controls') || '');
              if (panel) panel.hidden = !on;
            });
            if (focus) tab.focus();
          };
          tabs.forEach((t, i) => {
            t.addEventListener('click', () => select(t, false));
            t.addEventListener('keydown', (e) => {
              let j = null;
              if (e.key === 'ArrowRight') j = (i + 1) % tabs.length;
              else if (e.key === 'ArrowLeft') j = (i - 1 + tabs.length) % tabs.length;
              else if (e.key === 'Home') j = 0;
              else if (e.key === 'End') j = tabs.length - 1;
              if (j !== null) {
                e.preventDefault();
                select(tabs[j], true);
              }
            });
          });
        });

        // The film: the poster and one play button until it plays, then the
        // native controls.
        const film = document.querySelector('[data-film]');
        const filmVideo = film?.querySelector('video');
        const filmPlay = film?.querySelector('[data-film-play]');
        if (filmVideo && filmPlay) {
          filmVideo.controls = false;
          filmPlay.hidden = false;
          filmPlay.addEventListener('click', () => {
            filmVideo.play().catch(() => {});
          });
          filmVideo.addEventListener('play', () => {
            filmPlay.hidden = true;
            filmVideo.controls = true;
          });
        }

        // Lightbox: the 2x render of the mode on screen.
        const lb = document.querySelector('[data-lightbox-modal]');
        const img = lb?.querySelector('.ib-lightbox-img');
        if (!lb || !img) return;
        const close = () => {
          lb.hidden = true;
          document.body.style.overflow = '';
          img.removeAttribute('src');
        };
        document.querySelectorAll('[data-lightbox-dark]').forEach((b) =>
          b.addEventListener('click', () => {
            const light = document.documentElement.classList.contains('light');
            img.src = b.getAttribute(light ? 'data-lightbox-light' : 'data-lightbox-dark');
            img.alt = b.getAttribute('data-lightbox-alt') || '';
            lb.hidden = false;
            document.body.style.overflow = 'hidden';
          }),
        );
        document.querySelectorAll('[data-close-lightbox]').forEach((b) => b.addEventListener('click', close));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !lb.hidden) close();
        });
      })();
    </script>

    <Footer />
  </div>
</Base>

