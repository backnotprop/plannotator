---
// One VS Code screen in the Inbox page's screenshot frame (InboxShot), at 1x
// and 2x. The screens are real VS Code captures in its dark theme, so one
// render serves both site modes; a click opens the 2x render in the lightbox.
interface Props {
  name: string;
  alt: string;
  large?: boolean;
  eager?: boolean;
  class?: string;
}

const { name, alt, large = false, eager = false, class: className } = Astro.props;
const base = `/assets/guides-vscode/${name}`;
const sizes = '(min-width: 1152px) 1088px, (min-width: 768px) calc(100vw - 4rem), calc(100vw - 3rem)';
---
<figure class:list={['gv-shot', large && 'gv-shot-lg', className]}>
  <button
    type="button"
    class="gv-shot-btn"
    data-lightbox-src={`${base}@2x.webp`}
    data-lightbox-alt={alt}
    aria-label={`View ${alt} full size`}
  >
    <img
      src={`${base}.webp`}
      srcset={`${base}.webp 1440w, ${base}@2x.webp 2880w`}
      sizes={sizes}
      width="1440"
      height="900"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      alt={alt}
    />
    <span class="gv-shot-zoom" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
      </svg>
    </span>
  </button>
</figure>

<style>
  .gv-shot {
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #1f1f1f;
    box-shadow: 0 1px 2px color-mix(in oklab, var(--foreground) 6%, transparent);
  }

  .gv-shot-lg {
    box-shadow:
      0 30px 80px -20px color-mix(in oklab, #000 45%, transparent),
      0 1px 2px color-mix(in oklab, var(--foreground) 6%, transparent);
  }

  :global(.light) .gv-shot-lg {
    box-shadow: 0 30px 70px -24px color-mix(in oklab, var(--foreground) 22%, transparent);
  }

  .gv-shot-btn {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    position: relative;
  }

  .gv-shot-btn img {
    display: block;
    width: 100%;
    height: auto;
  }

  .gv-shot-btn:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .gv-shot-zoom {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    color: #fff;
    background: color-mix(in oklab, #000 55%, transparent);
    backdrop-filter: blur(3px);
    opacity: 0;
  }

  .gv-shot-zoom svg { width: 17px; height: 17px; }

  .gv-shot-btn:hover .gv-shot-zoom,
  .gv-shot-btn:focus-visible .gv-shot-zoom { opacity: 1; }
</style>
