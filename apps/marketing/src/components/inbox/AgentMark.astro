---
// An agent's mark on the agents pages: the brand marks the site already ships
// (public/assets/icon-*), else the Inbox's own drawn glyph for that agent
// (the outlines in packages/ui/components/inbox-thread/icons.tsx, TAB_GLYPHS),
// else its initials. Decoration: the agent's name always sits beside it.
interface Props {
  slug: string;
  size?: number;
}

const { slug, size = 24 } = Astro.props;

const images: Record<string, { src: string; class?: string }> = {
  'claude-code': { src: '/assets/icon-claude.svg' },
  pi: { src: '/assets/icon-pi.svg' },
  opencode: { src: '/assets/icon-opencode-dark.svg', class: 'icon-opencode' },
  codex: { src: '/assets/icon-codex.png' },
  'gemini-cli': { src: '/assets/icon-gemini.png' },
  'copilot-cli': { src: '/assets/icon-copilot.svg', class: 'icon-copilot' },
  amp: { src: '/assets/icon-amp.svg' },
  droid: { src: '/assets/icon-droid.png' },
  'kiro-cli': { src: '/assets/icon-kiro.svg' },
};

// Copied from TAB_GLYPHS (cursor, qwen, dsh, cline, openclaw, hermes) and PATHS.code.
const glyphs: Record<string, string> = {
  cursor: 'M12 2.5 20.5 7.25v9.5L12 21.5 3.5 16.75v-9.5Z M12 12l8.5-4.75 M12 12v9.5 M12 12 3.5 7.25',
  'qwen-code':
    'M12 2.5 20.23 7.25v9.5L12 21.5 3.77 16.75v-9.5Z M8.97 10.25h6.06L12 15.5Z M8.97 10.25 12 2.5 M15.03 10.25l5.2 6.5 M12 15.5l-8.23 1.25',
  'deepseek-harness': 'M6 4h5a7 7 0 0 1 0 14H6Z M3 21c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0',
  cline:
    'M9.6 5.3A2.55 2.55 0 1 1 14.4 5.3H17.9A2.4 2.4 0 0 1 20.3 7.7V10.6L22.9 13.6 20.3 16.7V19.6A2.4 2.4 0 0 1 17.9 22H6.1A2.4 2.4 0 0 1 3.7 19.6V16.7L1.1 13.6 3.7 10.6V7.7A2.4 2.4 0 0 1 6.1 5.3Z M8.9 11.6v4 M15.1 11.6v4',
  // OpenClaw lobster mark, from openclaw/openclaw ui/src/components/icon-data-tools.ts, MIT, Copyright (c) 2026 OpenClaw Foundation.
  openclaw:
    'M9.6 21.4V19.6C7.2 18.6 4.8 14.8 4.8 10.6 4.8 6.6 7.6 3.4 12 3.4S19.2 6.6 19.2 10.6C19.2 14.8 16.8 18.6 14.4 19.6V21.4 M9.6 19.6C11.2 20.2 12.8 20.2 14.4 19.6 M4.8 9.6C2.4 8.8 1.4 10.6 2.2 12.4 3 14 4.6 13.4 5.2 11.8 M19.2 9.6C21.6 8.8 22.6 10.6 21.8 12.4 21 14 19.4 13.4 18.8 11.8 M9.4 3.8 7.4 1.8 M14.6 3.8 16.6 1.8 M9.8 8.4V8.6 M14.2 8.4V8.6',
  'hermes-agent': 'M8 5v15 M16 5v15 M8 13.5h8 M8 8C6 7.6 4 6.8 2.5 5.2C3.3 8 5.4 9.8 8 10.4 M16 8c2-.4 4-1.2 5.5-2.8c-.8 2.8-2.9 4.6-5.5 5.2',
  'other-mcp-agents': 'M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5',
};

const initials: Record<string, string> = { 'mistral-vibe': 'V', 't3-code': 'T3' };

const image = images[slug];
const glyph = glyphs[slug];
---
<span class="ag-mark-box" style={`--ag-mark:${size}px`} aria-hidden="true">
  {image ? (
    <img src={image.src} alt="" class={image.class} width={size} height={size} loading="lazy" decoding="async" />
  ) : glyph ? (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={glyph} /></svg>
  ) : (
    <span class="ag-mark-text">{initials[slug] ?? slug.slice(0, 1).toUpperCase()}</span>
  )}
</span>

<style>
  .ag-mark-box {
    flex: 0 0 auto;
    width: var(--ag-mark);
    height: var(--ag-mark);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--foreground);
  }

  .ag-mark-box img,
  .ag-mark-box svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 4px;
  }

  .ag-mark-text {
    width: 100%;
    height: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    border: 1.5px solid currentColor;
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: calc(var(--ag-mark) * 0.42);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
</style>
