---
// The Spaces header ("header B"), shared by /workspaces/ and /workspaces/pricing/:
// the name, "Open source" with its star count and a drop-down of repositories,
// Pricing, the light/dark switch and Book a call. Under 760px wide the words fold
// into one menu (scripts/spaces/header.js); the switch is scripts/spaces/theme-switch.js.
// The pricing page passes current="pricing", which marks its Pricing links.
import SpacesOssList from './SpacesOssList.astro';
import { OSS_ORG_URL, ossMenu, readOssStars } from '../../lib/oss-stars';

interface Props {
  current?: 'pricing';
}

const { current } = Astro.props;
const here = current === 'pricing' ? 'page' : undefined;

// Every count comes from the snapshot checked into src/data/ (bun apps/marketing/scripts/oss-stars.ts
// refreshes it). Read as text so a missing or broken file leaves the words without counts instead
// of failing the build.
const ossSnapshot = Object.values(
  import.meta.glob<string>('../../data/oss-stars.json', { query: '?raw', import: 'default', eager: true }),
)[0];
const oss = ossMenu(readOssStars(ossSnapshot));

const BOOK_CALL =
  'https://cal.com/plannotator/workspaces?utm_source=plannotator&utm_medium=website&utm_campaign=founder_call&utm_content=header';
const PRICING = '/workspaces/pricing/';
const STAR =
  'M12 1.500 14.590 8.440 21.990 8.760 16.180 13.360 18.170 20.490 12 16.400 5.830 20.490 7.820 13.360 2.010 8.760 9.410 8.440Z';
---
<header class="nav"><a class="act home" href="/workspaces/" aria-label="Plannotator Spaces"><svg viewBox="0 0 64 64" width="24" height="24" aria-hidden="true"><defs><mask id="mc" maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64"><rect width="64" height="64" fill="white"/><path d="M3 32 A29 8 0 0 0 61 32" transform="rotate(-20 32 32)" fill="none" stroke="black" stroke-width="10.5" stroke-linecap="round"/></mask><mask id="mb" maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64"><rect width="64" height="64" fill="white"/><rect x="14" y="7" width="36" height="50" rx="10" fill="black"/></mask></defs><g mask="url(#mc)" fill="currentColor"><rect x="17" y="10" width="30" height="44" rx="7"/></g><g mask="url(#mb)"><path d="M3 32 A29 8 0 0 1 61 32" transform="rotate(-20 32 32)" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></g><path d="M3 32 A29 8 0 0 0 61 32" transform="rotate(-20 32 32)" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg><span class="nm"><span class="nmp">Plannotator</span> Spaces</span></a><nav class="lk" aria-label="Site"><div class="lk-dd"><button type="button" class="lk-t" aria-label={oss.label} aria-expanded="false" aria-controls="spaces-oss"><span aria-hidden="true">Open source</span>{oss.count && <span class="lk-n" aria-hidden="true"><svg class="lk-s" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path fill="currentColor" d={STAR}/></svg><span class="lk-c">{oss.count}</span></span>}<svg class="lk-v" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true"><path d="m2 3.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button><div class="lk-p" id="spaces-oss" role="region" aria-label="Open source" data-state="closed"><SpacesOssList summary={oss.summary} lead={oss.lead} rows={oss.rows} all={oss.all} allHref={OSS_ORG_URL} /></div></div><a href={PRICING} aria-current={here}>Pricing</a></nav><button type="button" class="thm" aria-label="Switch to light theme. Current theme: Dark."><svg class="thm-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg><svg class="thm-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg></button><a class="act bkb" href={BOOK_CALL}>Book a call</a><div class="hm"><button type="button" class="hm-b" aria-label="Menu" aria-expanded="false" aria-controls="spaces-menu"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path class="hm-i" d="M2 4h12M2 8h12M2 12h12" fill="none" stroke="currentColor" stroke-width="1.4"/><path class="hm-x" d="M3.5 3.5l9 9M12.5 3.5l-9 9" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button><div class="hm-dim"></div><nav class="hm-sheet" id="spaces-menu" aria-label="Site"><details class="os-ph"><summary aria-label={oss.label}><span aria-hidden="true">Open source</span><span class="hm-r" aria-hidden="true">{oss.count && <span class="lk-n" aria-hidden="true"><svg class="lk-s" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path fill="currentColor" d={STAR}/></svg><span class="lk-c">{oss.count}</span></span>}<svg class="lk-v" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true"><path d="m2 3.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></span></summary><div class="os-body"><SpacesOssList summary={oss.summary} lead={oss.lead} rows={oss.rows} all={oss.all} allHref={OSS_ORG_URL} /></div></details><a href={PRICING} aria-current={here}>Pricing</a><div class="hm-theme"><span>Theme</span><button type="button" class="thm" aria-label="Switch to light theme. Current theme: Dark."><svg class="thm-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg><svg class="thm-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg></button></div><a class="hm-book" href={BOOK_CALL}>Book a call</a></nav></div></header>
<!-- Without scripts the drop-down and the phone menu open while pointed at or focused, so every link stays reachable. -->
<noscript><style is:inline>.lk-dd:is(:hover,:focus-within) .lk-p{visibility:visible;opacity:1;transform:none;pointer-events:auto}.hm:is(:hover,:focus-within) .hm-sheet{display:block}</style></noscript>
<script src="../../scripts/spaces/header.js"></script>
<script src="../../scripts/spaces/theme-switch.js"></script>
