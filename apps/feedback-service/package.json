{
  "name": "@plannotator/feedback-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create plannotator-feedback",
    "db:migrate": "wrangler d1 execute plannotator-feedback --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute plannotator-feedback --local --file=./schema.sql",
    "db:read": "wrangler d1 execute plannotator-feedback --remote --json --command=\"SELECT id, created_at, category, surface, version, os, contact, message FROM feedback ORDER BY id DESC LIMIT 100\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "wrangler": "^4.151.2"
  }
}
