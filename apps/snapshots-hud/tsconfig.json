{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@plannotator/ui/*": ["../../packages/ui/*"],
      "@plannotator/shared/*": ["../../packages/shared/*"],
      "@plannotator/snapshots-hud": ["../../packages/snapshots-hud/index.ts"],
      "@plannotator/snapshots-hud/*": ["../../packages/snapshots-hud/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["index.tsx"]
}
