{
  "name": "@plannotator/dsh",
  "version": "0.28.39",
  "type": "module",
  "description": "Plannotator plugin for DeepSeek Harness - review DSH plans with visual annotation",
  "author": "backnotprop",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backnotprop/plannotator.git",
    "directory": "apps/dsh-plugin"
  },
  "homepage": "https://github.com/backnotprop/plannotator",
  "bugs": {
    "url": "https://github.com/backnotprop/plannotator/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plannotator",
    "plan-review",
    "ai-agent",
    "coding-agent"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "bun build index.ts --outfile dist/index.js --target node",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  }
}
