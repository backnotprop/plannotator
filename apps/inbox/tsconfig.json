{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["node"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@plannotator/ui/*": ["../../packages/ui/*"],
      "@plannotator/inbox": ["../../packages/inbox/index.ts"],
      "@plannotator/inbox/*": ["../../packages/inbox/*"],
      "@plannotator/review-editor/worker-pool": ["../../packages/review-editor/workerPool.tsx"],
      "#guide-reader": ["../../packages/inbox/guide/reader-module.d.ts"],
      "#surface-guide-reader": ["../../packages/inbox/guide/surface-reader-module.d.ts"],
      "#search-palette": ["../../packages/inbox/search/SearchPalette.tsx"],
      "#platform-post": ["../../packages/inbox/guide/platform-post-module.d.ts"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["index.tsx", "surface.tsx", "shape.tsx"]
}
