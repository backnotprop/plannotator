{
  // The Worker: strict, no DOM, Workers types only (`tsc --noEmit -p
  // apps/telemetry`, part of the root typecheck). The tests under test/ run
  // in the root `bun test`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts"]
}
