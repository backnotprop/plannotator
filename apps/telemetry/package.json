{
  "name": "@plannotator/telemetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plannotator's daily ping: a Cloudflare Worker that adds 1 to a daily total in D1 per (day, version, age bucket). No IP, no headers, no per-request row.",
  "scripts": {
    "dev": "wrangler dev --local",
    "db:create": "wrangler d1 create plannotator-ping",
    "migrate:local": "wrangler d1 migrations apply plannotator-ping --local",
    "migrate": "wrangler d1 migrations apply plannotator-ping --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "wrangler": "^4.156.1"
  }
}
