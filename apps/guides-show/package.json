{
  "name": "@plannotator/guides-show",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "guides.show \u2014 the portable Guided Review viewer (CDN build) and its Cloudflare Worker.",
  "scripts": {
    "dev": "vite --config vite.viewer.config.ts",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "check:budgets": "bun run build/check-budgets.ts",
    "dev:worker": "wrangler dev --local --host localhost:8787 --port 8787",
    "deploy:worker": "wrangler deploy",
    "deploy:viewer": "bun run build/deploy-viewer.ts",
    "verify:viewer": "bun run build/verify-viewer.ts",
    "export:samples": "bun run build/export-sample.ts",
    "serve:local": "bun run build/serve-local.ts",
    "test": "bun test worker share viewer build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:viewer": "tsc --noEmit -p tsconfig.viewer.json",
    "sync:manifest": "bun run build/sync-manifest.ts"
  },
  "dependencies": {
    "@pierre/diffs": "1.5.2",
    "@plannotator/core": "workspace:*",
    "@plannotator/guide-viewer": "workspace:*",
    "@plannotator/review-editor": "workspace:*",
    "@plannotator/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "@cloudflare/workers-types": "^4.20241218.0",
    "wrangler": "^4.151.2"
  }
}
