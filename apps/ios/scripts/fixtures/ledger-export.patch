diff --git a/src/export/export-writer.ts b/src/export/export-writer.ts
index 90e22c8..8898918 100644
--- a/src/export/export-writer.ts
+++ b/src/export/export-writer.ts
@@ -2,6 +2,10 @@ import type { Db } from "../db";
 import type { WriteStream } from "node:fs";
 import { EXPORT_SQL } from "./queries";
 import { toCsv, CSV_HEADER } from "./csv";
+import { removePartial } from "./partial-file";
+
+/** Rows written per flush: big enough to keep the disk busy, small enough to keep memory flat. */
+export const FLUSH_EVERY = 500;
 
 export interface ExportResult {
   rows: number;
@@ -10,8 +14,35 @@ export interface ExportResult {
 
 export async function writeExport(db: Db, out: WriteStream): Promise<ExportResult> {
   out.write(CSV_HEADER + "\n");
-  const rows = await db.query(EXPORT_SQL).all();
-  const text = rows.map(toCsv).join("\n");
-  out.write(text);
-  return { rows: rows.length, bytes: Buffer.byteLength(text) };
+  const cursor = db.query(EXPORT_SQL).iterate();
+  let batch: string[] = [];
+  let rows = 0;
+  let bytes = 0;
+  try {
+    for (const row of cursor) {
+      batch.push(toCsv(row));
+      rows += 1;
+      if (batch.length === FLUSH_EVERY) {
+        bytes += await flush(out, batch);
+        batch = [];
+      }
+    }
+    bytes += await flush(out, batch);
+  } catch (error) {
+    cursor.return?.();
+    out.destroy();
+    await removePartial(out.path.toString());
+    throw error;
+  }
+  return { rows, bytes };
+}
+
+/** Writes one batch and waits for the stream to drain before the next one. */
+async function flush(out: WriteStream, batch: string[]): Promise<number> {
+  if (batch.length === 0) return 0;
+  const text = batch.join("\n") + "\n";
+  if (!out.write(text)) {
+    await new Promise<void>((resolve) => out.once("drain", resolve));
+  }
+  return Buffer.byteLength(text);
 }
