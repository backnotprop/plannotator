    ".": "./index.ts",
    "./model": "./model/index.ts",
    "./events": "./events/index.ts",
    "./view": "./view/index.ts",
    "./react": "./react/index.ts",
    "./snapshot": "./snapshot/index.ts",
    "./snapshot-block": "./snapshot/block.ts",
    "./canvas.css": "./canvas.css",
    "./unfurl": "./unfurl/index.ts"
  },
  "scripts": {
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "bench": "bun bench/run.ts"
  },
  "dependencies": {
    "@plannotator/core": "workspace:*",
    "lucide-react": "^1.59.0"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@plannotator/ui": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
