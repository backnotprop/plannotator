{
  "name": "@plannotator/canvas",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Plannotator's own canvas: a typed document model, an event system a person and an agent share, a DOM renderer, and live snapshots that embed in a plan. Not wired into any product surface yet.",
